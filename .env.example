COMPUTER_AGENTS_API_KEY=
COMPUTER_AGENTS_BASE_URL=https://api.computer-agents.com
STOCKIFI_PLATFORM_URL=https://platform.computer-agents.com
STOCKIFI_PROJECT_ID=
STOCKIFI_ENVIRONMENT_NAME=stockifi-hospitality-pipeline
STOCKIFI_EXISTING_ENVIRONMENT_ID=
STOCKIFI_DATABASE_NAME=stockifi-hospitality-intelligence
STOCKIFI_BATCH_SIZE=5
STOCKIFI_PASSES_PER_MONTH=2
STOCKIFI_SCHEDULE_CRON=0 4 1,15 * *
STOCKIFI_TIMEZONE=Europe/Berlin
STOCKIFI_RESTAURANT_SLUG=casa-lucia-berlin
STOCKIFI_BATCH_RESTAURANT_SLUGS=
STOCKIFI_RESTAURANTS_FILE=./data/restaurants.sample.csv
STOCKIFI_COLLECTION_RESTAURANTS=restaurants
STOCKIFI_COLLECTION_MENU_SNAPSHOTS=menuSnapshots
STOCKIFI_COLLECTION_CHANGE_EVENTS=changeEvents
STOCKIFI_COLLECTION_BATCH_RUNS=batchRuns

# Hybrid integration points for the live demo.
STOCKIFI_FIRECRAWL_MCP_URL=
STOCKIFI_FIRECRAWL_BEARER_TOKEN=
STOCKIFI_FIRECRAWL_BASE_URL=
STOCKIFI_FIRECRAWL_API_KEY=
STOCKIFI_LOCAL_MODEL_BASE_URL=

# Hosted Computer Agents function setup.
# `npm run setup:cloud` creates/updates:
# - stockifi-firecrawl-router
# - stockifi-orchestrator
# - stockifi-menu-results database and collections
# - stockifi-firecrawl-secrets secrets vault
STOCKIFI_SETUP_FIRECRAWL_FUNCTION=1
STOCKIFI_SETUP_ORCHESTRATOR_FUNCTION=1
STOCKIFI_FIRECRAWL_FUNCTION_NAME=stockifi-firecrawl-router
STOCKIFI_ORCHESTRATOR_FUNCTION_NAME=stockifi-orchestrator
STOCKIFI_FIRECRAWL_FUNCTION_REGION=europe-west1
STOCKIFI_ORCHESTRATOR_FUNCTION_REGION=europe-west1
STOCKIFI_FIRECRAWL_FUNCTION_RUNTIME=nodejs22
STOCKIFI_ORCHESTRATOR_FUNCTION_RUNTIME=nodejs22
STOCKIFI_RESULTS_DATABASE_NAME=stockifi-menu-results
STOCKIFI_RESULTS_DATABASE_LOCATION=eur3
STOCKIFI_USE_SECRETS_VAULT=1
STOCKIFI_USE_RESULTS_DATABASE=1
STOCKIFI_EMBED_FIRECRAWL_SECRET=0
STOCKIFI_ORCHESTRATOR_AUTH_MODE=private
STOCKIFI_ORCHESTRATOR_BATCH_SIZE=5
STOCKIFI_ORCHESTRATOR_AGENT_FALLBACK_LIMIT=3

# Re-run variables printed by `npm run setup:cloud`.
STOCKIFI_FIRECRAWL_SERVER_ID=
STOCKIFI_FIRECRAWL_SECRETS_SERVER_ID=
STOCKIFI_RESULTS_DATABASE_ID=
STOCKIFI_FIRECRAWL_FUNCTION_URL=
STOCKIFI_ORCHESTRATOR_SERVER_ID=
STOCKIFI_ORCHESTRATOR_SECRETS_SERVER_ID=
STOCKIFI_ORCHESTRATOR_FUNCTION_URL=
STOCKIFI_ORCHESTRATOR_TOKEN=
STOCKIFI_ENVIRONMENT_ID=
STOCKIFI_EXTRACTOR_AGENT_ID=

# Override models if you want to show built-in vs external/hybrid routing.
STOCKIFI_DISCOVERY_MODEL=claude-haiku-4-5
STOCKIFI_CLASSIFIER_MODEL=claude-haiku-4-5
STOCKIFI_EXTRACTION_MODEL=claude-haiku-4-5
STOCKIFI_CHANGE_DETECTION_MODEL=claude-haiku-4-5
STOCKIFI_OUTREACH_MODEL=claude-haiku-4-5
STOCKIFI_COORDINATOR_MODEL=claude-haiku-4-5
